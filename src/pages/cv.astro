---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CV — Madalin Iosu">
    <div class="max-w-4xl mx-auto px-6 py-12">
        <!-- Download -->
        <div class="mb-14 pb-8 border-b border-gray-200 flex justify-end">
            <a
                href="/CV_Madalin_Iosu_2026.pdf"
                download
                class="inline-block px-8 py-3 bg-orange-600 text-white text-sm font-medium rounded hover:bg-orange-700 transition-colors"
            >
                Download PDF
            </a>
        </div>
        <!-- Header -->
        <header
            class="flex flex-col sm:flex-row justify-between items-start gap-6 mb-10"
        >
            <div>
                <h1 class="text-5xl font-bold text-orange-600">Madalin Iosu</h1>
                <p class="text-gray-500 italic mt-2">
                    Frontend Developer AI-Focused
                </p>
            </div>
            <div class="text-sm text-gray-600 space-y-1 sm:text-right">
                <p>Pego, Spain</p>
                <p>+34 624 287 665</p>
                <p>
                    <a
                        href="mailto:iosu.gm@gmail.com"
                        class="hover:text-orange-600">iosu.gm@gmail.com</a
                    >
                </p>
                <p>
                    <a
                        href="https://github.com/madaliniosu"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-orange-600">github.com/madaliniosu</a
                    >
                </p>
                <p>
                    <a
                        href="https://linkedin.com/in/madaliniosu"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-orange-600"
                        >linkedin.com/in/madaliniosu</a
                    >
                </p>
            </div>
        </header>

        <hr class="border-gray-200 mb-10" />

        <!-- Two-column body -->
        <div class="grid grid-cols-1 md:grid-cols-[1fr_1.8fr] gap-10">
            <!-- LEFT COLUMN -->
            <div class="space-y-8 text-sm">
                <!-- Skills -->
                <section>
                    <h2 class="text-lg font-bold text-orange-600 mb-4">
                        Skills
                    </h2>
                    <div class="space-y-4">
                        <div>
                            <h3 class="font-semibold text-gray-800">
                                Languages
                            </h3>
                            <ul class="mt-1 space-y-0.5 text-gray-600">
                                <li>JS, TS, HTML, CSS</li>
                            </ul>
                        </div>

                        <div>
                            <h3 class="font-semibold text-gray-800">
                                Frameworks / Libraries
                            </h3>
                            <ul class="mt-1 space-y-0.5 text-gray-600">
                                <li>Angular</li>
                                <li>React</li>
                                <li>Next.js</li>
                                <li>Astro</li>
                                <li>Node.js + Express.js</li>
                            </ul>
                        </div>

                        <div>
                            <h3 class="font-semibold text-gray-800">Styling</h3>
                            <ul class="mt-1 space-y-0.5 text-gray-600">
                                <li>SCSS / SASS</li>
                                <li>Tailwind CSS</li>
                                <li>Bootstrap</li>
                            </ul>
                        </div>

                        <div>
                            <h3 class="font-semibold text-gray-800">
                                Database & ORM
                            </h3>
                            <ul class="mt-1 space-y-0.5 text-gray-600">
                                <li>Supabase</li>
                                <li>Prisma</li>
                                <li>Drizzle ORM</li>
                            </ul>
                        </div>

                        <div>
                            <h3 class="font-semibold text-gray-800">
                                AI & APIs
                            </h3>
                            <ul class="mt-1 space-y-0.5 text-gray-600">
                                <li>Anthropic Claude API</li>
                                <li>OpenAI ChatGPT</li>
                                <li>Google Gemini</li>
                                <li>Vercel AI SDK</li>
                                <li>Stripe</li>
                                <li>Resend</li>
                            </ul>
                        </div>

                        <div>
                            <h3 class="font-semibold text-gray-800">Testing</h3>
                            <ul class="mt-1 space-y-0.5 text-gray-600">
                                <li>Jest</li>
                            </ul>
                        </div>

                        <div>
                            <h3 class="font-semibold text-gray-800">Design</h3>
                            <ul class="mt-1 space-y-0.5 text-gray-600">
                                <li>Figma</li>
                                <li>Photoshop</li>
                                <li>Illustrator</li>
                            </ul>
                        </div>

                        <div>
                            <h3 class="font-semibold text-gray-800">CMS</h3>
                            <ul class="mt-1 space-y-0.5 text-gray-600">
                                <li>Sanity</li>
                                <li>WordPress</li>
                                <li>Elementor</li>
                                <li>WPBakery</li>
                            </ul>
                        </div>

                        <div>
                            <h3 class="font-semibold text-gray-800">
                                Development Tools
                            </h3>
                            <ul class="mt-1 space-y-0.5 text-gray-600">
                                <li>Git, npm</li>
                                <li>Vercel, Netlify</li>
                            </ul>
                        </div>
                    </div>
                </section>

                <!-- Education -->
                <section>
                    <h2 class="text-lg font-bold text-orange-600 mb-4">
                        Education
                    </h2>
                    <div class="space-y-4 text-gray-600">
                        <div>
                            <p class="font-semibold text-gray-800">
                                JavaScript from Scratch
                            </p>
                            <p>Software Development Academy</p>
                        </div>
                        <div>
                            <p class="font-semibold text-gray-800">
                                Banking and Finance Bachelors
                            </p>
                            <p>Ecological University of Bucharest</p>
                        </div>
                    </div>
                </section>
            </div>

            <!-- RIGHT COLUMN -->
            <div class="space-y-10 text-sm">
                <!-- Experience -->
                <section>
                    <h2 class="text-lg font-bold text-orange-600 mb-6">
                        Experience
                    </h2>
                    <div class="space-y-8">
                        <div>
                            <h3 class="font-bold text-gray-900">
                                Frontend Developer @ Revital
                            </h3>
                            <p class="text-gray-500 italic mb-2">
                                Jan 2024 – Aug 2025
                            </p>
                            <p class="text-gray-700 mb-3">
                                Promoted from Junior to Frontend Developer
                                within 12 months. Part of a 5-person
                                cross-functional team building a heart
                                monitoring application that aggregated data from
                                smartphones and smart wearables.
                            </p>
                            <ul class="space-y-1.5 text-gray-700">
                                <li class="flex gap-2">
                                    <span class="text-orange-500 mt-0.5">–</span
                                    >Developed frontend features for a digital
                                    health platform processing real-time data
                                    from smart devices
                                </li>
                                <li class="flex gap-2">
                                    <span class="text-orange-500 mt-0.5">–</span
                                    >Built a client-facing PR platform to manage
                                    partner relationships, client portfolios,
                                    and event coordination
                                </li>
                                <li class="flex gap-2">
                                    <span class="text-orange-500 mt-0.5">–</span
                                    >Coordinated with outsourced development
                                    teams to align on implementation and
                                    delivery
                                </li>
                                <li class="flex gap-2">
                                    <span class="text-orange-500 mt-0.5">–</span
                                    >Delivered WordPress-based projects for
                                    external clients alongside core product work
                                </li>
                                <li class="flex gap-2">
                                    <span class="text-orange-500 mt-0.5">–</span
                                    >Implemented responsive, production-ready
                                    interfaces from Figma designs
                                </li>
                            </ul>
                        </div>

                        <div>
                            <h3 class="font-bold text-gray-900">
                                Product Manager @ Convergent 365
                            </h3>
                            <p class="text-gray-500 italic mb-2">
                                Sep 2019 – Aug 2023
                            </p>
                            <p class="text-gray-700 mb-3">
                                Led product development of a financial
                                management SaaS tool for Romanian small business
                                owners (SOHO segment).
                            </p>
                            <ul class="space-y-1.5 text-gray-700">
                                <li class="flex gap-2">
                                    <span class="text-orange-500 mt-0.5">–</span
                                    >Acted as the bridge between business
                                    stakeholders and the development team,
                                    translating requirements into actionable
                                    specs
                                </li>
                            </ul>
                        </div>

                        <div>
                            <h3 class="font-bold text-gray-900">
                                Expert Solution Sales Consultant — Orange
                                Romania
                            </h3>
                            <p class="text-gray-500 italic mb-2">
                                Oct 2015 – Sep 2019
                            </p>
                            <ul class="space-y-1.5 text-gray-700">
                                <li class="flex gap-2">
                                    <span class="text-orange-500 mt-0.5">–</span
                                    >Managed B2B and B2C technology solution
                                    sales across a portfolio of enterprise and
                                    SMB clients
                                </li>
                                <li class="flex gap-2">
                                    <span class="text-orange-500 mt-0.5">–</span
                                    >Promoted from Customer Care Representative
                                    within 11 months
                                </li>
                            </ul>
                        </div>
                    </div>
                </section>

                <!-- Freelance -->
                <section>
                    <h2 class="text-lg font-bold text-orange-600 mb-6">
                        Freelance Development Projects
                    </h2>
                    <div class="space-y-6">
                        <div>
                            <p class="text-gray-500 italic">2022</p>
                            <h3 class="font-bold text-gray-900">Wirbox</h3>
                            <p class="text-gray-700 mt-1">
                                Led the frontend redesign of a large agency
                                website with custom WordPress themes; optimized
                                page performance and refactored for
                                maintainability.
                            </p>
                            <a
                                href="https://www.nord-vest.ro/en/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-orange-600 hover:underline text-xs mt-1 inline-block"
                                >www.nord-vest.ro</a
                            >
                        </div>

                        <div>
                            <p class="text-gray-500 italic">2023</p>
                            <h3 class="font-bold text-gray-900">Ascendo</h3>
                            <p class="text-gray-700 mt-1">
                                Designed and built a responsive company website
                                with a modern UX.
                            </p>
                            <a
                                href="https://www.ascendo-2001.ro"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-orange-600 hover:underline text-xs mt-1 inline-block"
                                >www.ascendo-2001.ro</a
                            >
                        </div>

                        <div>
                            <p class="text-gray-500 italic">2025</p>
                            <h3 class="font-bold text-gray-900">
                                Livolo Bucuresti
                            </h3>
                            <p class="text-gray-700 mt-1">
                                Redesigned e-commerce store for smart home
                                accessories.
                            </p>
                            <a
                                href="https://www.livolobucuresti.ro"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-orange-600 hover:underline text-xs mt-1 inline-block"
                                >www.livolobucuresti.ro</a
                            >
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</BaseLayout>
