---
import CareerItem from "./CareerItem.astro";
---

<section id="career" class="mb-24">
    <h2 class="text-sm font-bold uppercase tracking-widest text-accent mb-6">
        Career
    </h2>

    <div class="flex flex-col gap-10">
        <CareerItem
            time="2023 - 2025"
            position="Frontend Developer"
            company="REVital"
            description="Part of a cross-functional team building a heart monitoring
            application that processed real-time data from smart devices and
            wearables. Shipped production interfaces from Figma designs, built a
            client-facing partner management platform, and delivered WordPress
            projects for external clients alongside core product work."
        />
        <CareerItem
            time="2021 – 2023"
            position="Product Manager"
            company="Convergent365"
            description="Product Manager at Convergent365, a financial management SaaS for
            Romanian entrepreneurs and business managers. Owned the roadmap for
            a platform that helped SMB owners track performance, plan budgets,
            and compare financials across scenarios. Worked across business,
            design, and development teams — translating complex financial
            workflows into product specs and shipping decisions under competing
            priorities."
        />
        <CareerItem
            time="2018 – 2021"
            position="Customer Care & Sales"
            company="Orange"
            description="Started in Customer Care, promoted to Expert Solution Sales
            Consultant within 11 months. Managed a mixed portfolio of B2B and
            B2C clients — selling mobile, internet, and technology solutions
            from Orange Romania's business catalogue. Developed the ability to
            listen past what customers said to understand what they actually
            needed, and built the communication and negotiation habits that now
            shape how I approach users and stakeholders as a developer."
        />
    </div>
</section>
