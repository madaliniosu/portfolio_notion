---
const { time, position, company, description } = Astro.props;
---

<div>
    <p class="text-xs text-muted uppercase tracking-widest mb-1">
        {time}
    </p>
    <h3 class="text-text font-semibold">
        {position}<span class="text-accent">· {company}</span>
    </h3>
    <p class="text-muted mt-2 leading-relaxed text-sm">
        {description}
    </p>
</div>
